# ==================== DATABASE & SUBSCRIPTION ====================
def get_made_bot_data_path(bot_username):
    return os.path.join(DATABASE_DIR, f"{bot_username}_settings.json")

def load_made_bot_settings(bot_username):
    file_path = get_made_bot_data_path(bot_username)
    if os.path.exists(file_path):
        try:
            with open(file_path, 'r', encoding='utf-8') as f:
                settings = json.load(f)
                made_bot_data[bot_username] = {**DEFAULT_BOT_SETTINGS, **settings}
        except Exception as e:
            logging.error(f"Error loading settings for {bot_username}: {e}")
            made_bot_data[bot_username] = DEFAULT_BOT_SETTINGS.copy()
    else:
        made_bot_data[bot_username] = DEFAULT_BOT_SETTINGS.copy()
        save_made_bot_settings(bot_username)

def save_made_bot_settings(bot_username):
    file_path = get_made_bot_data_path(bot_username)
    try:
        with open(file_path, 'w', encoding='utf-8') as f:
            json.dump(made_bot_data.get(bot_username, DEFAULT_BOT_SETTINGS), f, indent=4, ensure_ascii=False)
    except Exception as e:
        logging.error(f"Error saving settings for {bot_username}: {e}")

def is_user_admin(bot_username, user_id):
    load_made_bot_settings(bot_username)
    admins_list = made_bot_data[bot_username].get("admins", [ADMIN_ID])
    return user_id in admins_list or user_id == ADMIN_ID

def check_user_subscribed(bot_instance, user_id, bot_username):
    """تحقق صارم من الاشتراك الإجباري. أي فشل في التحقق يُعامل كعدم اشتراك."""
    if is_user_admin(bot_username, user_id):
        return True, []

    load_made_bot_settings(bot_username)
    bot_settings = made_bot_data.get(bot_username, DEFAULT_BOT_SETTINGS)

    # القنوات الأربع المحددة من صاحب البوت تبقى إلزامية دائماً.
    channels_to_check = list(MANDATORY_CHANNELS)
    custom_channels = bot_settings.get("channels", [])
    for ch in custom_channels:
        if ch and ch not in channels_to_check:
            channels_to_check.append(ch)

    not_subscribed = []
    for ch in channels_to_check:
        try:
            member = bot_instance.get_chat_member(chat_id=ch, user_id=user_id)
            if member.status not in ["creator", "administrator", "member"]:
                not_subscribed.append(ch)
        except Exception as e:
            # عدم قدرة البوت على التحقق من قناة إلزامية لا يمنح صلاحية دخول.
            logging.error(f"Subscription check error for {ch}: {e}")
            if ch not in not_subscribed:
                not_subscribed.append(ch)

    return len(not_subscribed) == 0, not_subscribed

