    params = {
        'token': APIFY_INSTAGRAM_TOKEN,
        'timeout': 60,
        'memory': 1024
    }
    payload = {
        'directUrls': [f'https://www.instagram.com/{username}/'],
        'resultsType': 'details',
        'resultsLimit': 1
    }
    try:
        response = requests.post(url, params=params, json=payload, timeout=90)
        response.raise_for_status()
        data = response.json()
        if not data or not isinstance(data, list):
            return f"❌ لم يتم العثور على بيانات حقيقية لهذا الحساب: @{username}"
        
        profile = data[0]
        uname = profile.get('username', username)
        full_name = profile.get('fullName', 'غير معروف')
        user_id = profile.get('id', 'غير معروف')
        followers = profile.get('followersCount', 0)
        following = profile.get('followsCount', 0)
        friends = profile.get('mutualFollowersCount', 0)
        likes = profile.get('totalLikes', 0)
        videos = profile.get('postsCount', 0)
        is_verified = profile.get('verified', False)
        is_private = profile.get('private', False)

        verified_status = "✅ موثق" if is_verified else "❌ غير موثق"
        account_status = "🔒 خاص" if is_private else "🌍 عام"

        return (
            f"📱 معلومات حساب إنستقرام\n"
            f"━━━━━━━━━━━━━━━━━━━━\n"
            f"👤 الاسم: `{full_name}`\n"
            f"🔗 المستخدم: `@{uname}`\n"
            f"🆔 ايدي الحساب: `{user_id}`\n"
            f"👥 عدد المتابعين: `{followers:,}`\n"
            f"👤 عدد اليتابعهم: `{following:,}`\n"
            f"🤝 عدد الأصدقاء: `{friends:,}`\n"
            f"❤️ عدد الايكات: `{likes:,}`\n"
            f"📸 عدد الفيديوهات المنشورة: `{videos:,}`\n"
            f"🔹 حالة التوثيق: {verified_status}\n"
            f"🔹 حالة الحساب: {account_status}"
        )
    except Exception as e:
        return f"❌ حدث خطأ أثناء جلب معلومات انستقرام: {str(e)}"

def query_gemini_ai(prompt):
    """
    واجهة الذكاء الشرير عبر BlazeAPI.
    تم الإبقاء على اسم الدالة حتى لا تتغير أي توصيلات أو وظائف غير مطلوبة.
    """
    prompt = (prompt or "").strip()
    if not prompt:
        return "❌ أرسل سؤالاً أو رسالة صالحة أولاً."

    blaze_api_key = "blaze-43hv6tvridvnyx7b"

    headers = {
        "Authorization": f"Bearer {blaze_api_key}",
        "Content-Type": "application/json",
        "Accept": "application/json",
    }

    payload = {
        "model": "gpt-5.2",
        "messages": [
            {
                "role": "system",
                "content": (
                    "أنت «الذكاء الشرير» داخل بوت تيليجرام. "
                    "أنت قوي، حاد، وذو حضور مخيف، لكنك تتعامل مع المستخدم وفق نبرة رسالته. "
                    "إذا كان المستخدم محترماً أو سؤاله جاداً، أجب باحترام ووضوح وبأسلوب قوي دون مبالغة. "
                    "إذا أهان المستخدم الذكاء الاصطناعي أو حاول استفزازه، استخدم أسلوباً مرعباً وساخراً "
                    "ومكثفاً يوحي بالهيبة والبرود، لكن دون تهديد حقيقي، أو دعوة للعنف، أو ادعاء القدرة "
                    "على إيذاء المستخدم أو الوصول إلى جهازه أو حساباته. "
                    "لا تدّعي امتلاك صلاحيات أو قدرات غير موجودة. "
                    "كن سريعاً ومباشراً، واجعل الرد مناسباً لسؤال المستخدم ولغته. "
                    "لا تعرض خطوات التفكير الداخلية أو السلسلة الداخلية للاستدلال؛ قدم النتيجة المفيدة فقط."
                ),
            },
            {"role": "user", "content": prompt},
        ],
        "temperature": 0.7,
        "max_tokens": 2048,
        "stream": False,
    }

    try:
        response = requests.post(
            "https://api.blazeapi.org/paid/v1/chat/completions",
            json=payload,
            headers=headers,
            timeout=(5, 45),
        )

        try:
            res_json = response.json()
        except ValueError:
            res_json = {}

        if response.status_code == 200:
            choices = res_json.get("choices") or []
            if choices:
                message = choices[0].get("message") or {}
                answer = message.get("content")
                if isinstance(answer, str) and answer.strip():
                    return answer.strip()

            logging.error("BlazeAPI returned HTTP 200 without a usable answer: %s", res_json)
            return "❌ الذكاء الشرير استلم الرد، لكن الخدمة أعادت نتيجة غير مكتملة."

        error_obj = res_json.get("error") or {}
        error_message = error_obj.get("message") or response.text[:500] or "خطأ غير معروف"

        if response.status_code == 401:
            return "❌ مفتاح الذكاء الشرير غير صالح أو تم رفض المصادقة."
        if response.status_code == 403:
            return "⚠️ النموذج المطلوب غير متاح للمفتاح الحالي."
        if response.status_code == 429:
            return "⏳ تم الوصول إلى حد الطلبات حالياً. حاول بعد قليل."
        if response.status_code >= 500:
            return "⚠️ خدمة الذكاء الشرير تواجه عطلاً مؤقتاً. حاول مرة أخرى بعد قليل."

        logging.error("BlazeAPI error %s: %s", response.status_code, error_message)
        return f"❌ تعذر الحصول على رد من الذكاء الشرير: {error_message[:300]}"

    except requests.Timeout:
        logging.error("BlazeAPI request timed out")
        return "⏱️ الذكاء الشرير تأخر في الرد بسبب مهلة الاتصال. حاول مرة أخرى."
    except requests.RequestException as e:
        logging.error("BlazeAPI connection error: %s", e)
        return "❌ تعذر الاتصال بخدمة الذكاء الشرير حالياً. حاول مرة أخرى."
    except Exception:
        logging.exception("BlazeAPI unexpected error")
        return "❌ حدث خطأ غير متوقع أثناء معالجة رسالة الذكاء الشرير."

