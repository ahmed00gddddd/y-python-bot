# ==================== LIVE REPORTING THREAD LOOP ====================
def run_reports_loop(bot_instance, chat_id, message_id, platform_name, username, report_type_name):
    active_reports[chat_id] = True
    total = 1
    success = 1
    failed = 0
    max_reports = 2000

    while total < max_reports and active_reports.get(chat_id, False):
        time.sleep(1.2)
        if not active_reports.get(chat_id, False):
            break
            
        step = random.randint(15, 45)
        total += step
        if total > max_reports:
            total = max_reports

        success = int(total * random.uniform(0.92, 0.97))
        failed = total - success

        keyboard = InlineKeyboardMarkup([
            [InlineKeyboardButton("إيقاف البلاغات 🛑", callback_data=f"stop_reports_{chat_id}")]
        ])

        text = (
            f"🚨 *جاري إرسال البلاغات المكثفة...*\n\n"
            f"👤 *اسم المستخدم:* `@{username}`\n"
            f"📱 *المنصة:* `{platform_name}`\n"
            f"📋 *نوع البلاغ:* `{report_type_name}`\n\n"
            f"البلاغات الناجحة ✅: {success}\n"
            f"البلاغات الفاشلة ❌: {failed}\n"
            f"جميع البلاغات: {total}"
        )

        try:
            bot_instance.edit_message_text(
                chat_id=chat_id,
                message_id=message_id,
                text=text,
                reply_markup=keyboard,
                parse_mode=ParseMode.MARKDOWN
            )
        except Exception as e:
            logging.error(f"Report update loop error: {e}")
            pass

    is_stopped = not active_reports.get(chat_id, False)
    active_reports[chat_id] = False

