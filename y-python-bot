def main():
    global BOT_USERNAME
    BOT_USERNAME = get_bot_username_from_token(BOT_TOKEN)
    load_made_bot_settings(BOT_USERNAME)

    updater = Updater(BOT_TOKEN, use_context=True)
    dp = updater.dispatcher

    dp.add_handler(CommandHandler("start", start_made_bot))
    dp.add_handler(CallbackQueryHandler(handle_callback_query_made_bot))
    dp.add_handler(MessageHandler(Filters.all & ~Filters.command, handle_message_made_bot))

    logging.info(f"🚀 Started Bot successfully: @{BOT_USERNAME}")
    updater.start_polling()
    updater.idle()

if __name__ == '__main__':
    main()
