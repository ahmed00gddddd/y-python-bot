class _LinkPageParser(HTMLParser):
    """Parser صغير لاستخراج مؤشرات تشغيلية من HTML بدون تنفيذ JavaScript."""
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.title = ""
        self._in_title = False
        self.forms = 0
        self.password_inputs = 0
        self.email_inputs = 0
        self.external_scripts = 0
        self.links = 0
        self.meta_refresh = False

    def handle_starttag(self, tag, attrs):
        attrs_dict = dict(attrs)
        tag = tag.lower()
        if tag == "title":
            self._in_title = True
        elif tag == "form":
            self.forms += 1
        elif tag == "input":
            input_type = str(attrs_dict.get("type", "text")).lower()
            if input_type == "password":
                self.password_inputs += 1
            elif input_type == "email":
                self.email_inputs += 1
        elif tag == "script":
            src = attrs_dict.get("src")
            if src:
                self.external_scripts += 1
        elif tag == "a":
            self.links += 1
        elif tag == "meta":
            http_equiv = str(attrs_dict.get("http-equiv", "")).lower()
            if http_equiv == "refresh":
                self.meta_refresh = True

    def handle_endtag(self, tag):
        if tag.lower() == "title":
            self._in_title = False

    def handle_data(self, data):
        if self._in_title and not self.title:
            self.title = " ".join(data.split())[:200]


def _normalize_scan_url(target_link):
    raw = (target_link or "").strip()
    if not raw:
        raise ValueError("الرابط فارغ.")
    if not re.match(r"^https?://", raw, re.IGNORECASE):
        raw = "https://" + raw
    parsed = urllib.parse.urlparse(raw)
    if parsed.scheme.lower() not in ("http", "https") or not parsed.netloc:
        raise ValueError("الرابط يجب أن يكون HTTP أو HTTPS صالحاً.")
    return raw


def _host_resolves_to_public_address(hostname):
    """يمنع الفحص المحلي المباشر لتقليل مخاطر SSRF على خادم البوت."""
    try:
        addresses = socket.getaddrinfo(hostname, None, type=socket.SOCK_STREAM)
    except Exception:
        return False
    if not addresses:
        return False
    for item in addresses:
        ip_text = item[4][0]
        try:
            ip_obj = ipaddress.ip_address(ip_text)
            if (ip_obj.is_private or ip_obj.is_loopback or ip_obj.is_link_local or
                    ip_obj.is_multicast or ip_obj.is_reserved or ip_obj.is_unspecified):
                return False
        except ValueError:
            return False
    return True


def _safe_http_inspect(start_url, max_redirects=5, max_body_bytes=262144):
    """يجلب metadata عامة فقط، ويتتبع التحويلات يدوياً مع تحقق SSRF لكل مضيف."""
    session = requests.Session()
    session.headers.update({
        "User-Agent": "Mozilla/5.0 (compatible; Raven-Link-Scanner/1.0; +https://www.virustotal.com/)"
    })

    current = start_url
    redirects = []
    response = None

    for _ in range(max_redirects + 1):
        parsed = urllib.parse.urlparse(current)
        hostname = parsed.hostname
        if not hostname or not _host_resolves_to_public_address(hostname):
            raise ValueError("تم رفض الاتصال بالمضيف لأنه غير عام أو تعذر التحقق من عنوانه.")

        response = session.get(
            current,
            timeout=(8, 15),
            allow_redirects=False,
            stream=True,
        )

        location = response.headers.get("Location")
        if response.status_code in (301, 302, 303, 307, 308) and location:
            next_url = urllib.parse.urljoin(current, location)
            redirects.append({
                "status": response.status_code,
                "from": current,
                "to": next_url,
            })
            response.close()
            current = _normalize_scan_url(next_url)
            continue
        break

    if response is None:
        raise RuntimeError("لم يتم الحصول على استجابة HTTP.")

    content_type = response.headers.get("Content-Type", "").lower()
    content_length = response.headers.get("Content-Length", "")
    body = b""
    if any(t in content_type for t in ("text/html", "application/xhtml+xml", "text/plain")):
        try:
            body = response.raw.read(max_body_bytes + 1)
        finally:
            response.close()
        body = body[:max_body_bytes]
    else:
        response.close()

    parser = _LinkPageParser()
    if body:
        try:
            parser.feed(body.decode("utf-8", errors="replace"))
        except Exception:
            pass

    return {
        "final_url": current,
        "status_code": response.status_code,
        "content_type": content_type or "غير محدد",
        "content_length": content_length or "غير محدد",
        "server": response.headers.get("Server", "غير معلن"),
        "redirects": redirects,
        "title": parser.title or "غير متوفر",
        "forms": parser.forms,
        "password_inputs": parser.password_inputs,
        "email_inputs": parser.email_inputs,
        "external_scripts": parser.external_scripts,
        "links": parser.links,
        "meta_refresh": parser.meta_refresh,
    }


def _virustotal_url_report(url_to_check):
    """يحصل على تقرير URL أو يرسله إلى VirusTotal ثم ينتظر نتيجة التحليل."""
    headers = {
        "x-apikey": VIRUSTOTAL_API_KEY,
        "accept": "application/json",
    }
    url_id = base64.urlsafe_b64encode(url_to_check.encode("utf-8")).decode("ascii").rstrip("=")
    report_url = f"https://www.virustotal.com/api/v3/urls/{url_id}"

    response = requests.get(report_url, headers=headers, timeout=20)
    if response.status_code == 200:
        return response.json().get("data", {}).get("attributes", {}), None

    if response.status_code != 404:
        try:
            detail = response.json().get("error", {}).get("message", response.text[:200])
        except Exception:
            detail = response.text[:200]
        return None, f"VirusTotal HTTP {response.status_code}: {detail}"

    scan_response = requests.post(
        "https://www.virustotal.com/api/v3/urls",
        headers=headers,
        data={"url": url_to_check},
        timeout=20,
    )
    if scan_response.status_code not in (200, 201):
        try:
            detail = scan_response.json().get("error", {}).get("message", scan_response.text[:200])
        except Exception:
            detail = scan_response.text[:200]
        return None, f"تعذر إرسال الرابط إلى VirusTotal: HTTP {scan_response.status_code}: {detail}"

    analysis_id = scan_response.json().get("data", {}).get("id")
    if not analysis_id:
        return None, "VirusTotal لم يُرجع معرّف التحليل."

    analysis_url = f"https://www.virustotal.com/api/v3/analyses/{analysis_id}"
    last_status = "queued"
    for _ in range(10):
        time.sleep(2)
        analysis_response = requests.get(analysis_url, headers=headers, timeout=20)
        if analysis_response.status_code != 200:
            continue
        analysis_data = analysis_response.json().get("data", {})
        attrs = analysis_data.get("attributes", {})
        last_status = attrs.get("status", last_status)
        if last_status == "completed":
            stats = attrs.get("stats", {})
            return {"last_analysis_stats": stats, "analysis_status": last_status}, None

    # حتى لو انتهت مهلة الانتظار، نحاول الحصول على التقرير النهائي مرة أخيرة.
    response = requests.get(report_url, headers=headers, timeout=20)
    if response.status_code == 200:
        return response.json().get("data", {}).get("attributes", {}), None
    return None, f"لم يكتمل تحليل VirusTotal خلال المهلة. الحالة الأخيرة: {last_status}"


