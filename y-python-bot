def handle_message_made_bot(update, context):
    user_id = update.effective_user.id
    chat_id = update.effective_chat.id
    text = update.message.text if update.message and update.message.text else ""

    current_bot_username = BOT_USERNAME
    load_made_bot_settings(current_bot_username)
    bot_settings = made_bot_data[current_bot_username]

    if current_bot_username not in bot_user_states:
        bot_user_states[current_bot_username] = {}

    user_state = bot_user_states[current_bot_username].get(user_id)

    if user_state in {"await_html_encrypt", "await_python_encrypt"}:
        language = "html" if user_state == "await_html_encrypt" else "python"
        expected_extension = ".html" if language == "html" else ".py"
        bot_user_states[current_bot_username][user_id] = None

        try:
            if update.message and update.message.document:
                source_bytes = _read_uploaded_code_document(context.bot, update, expected_extension)
            elif text:
                source_bytes = text.encode("utf-8")
            else:
                raise ValueError(
                    f"أرسل ملفاً بامتداد {expected_extension} أو أرسل الكود كنص."
                )

            _send_encrypted_code_file(context.bot, chat_id, source_bytes, language)
        except ValueError as exc:
            send_message(context.bot, chat_id, f"❌ {exc}")
        except Exception:
            logging.exception("Code file encryption error")
            send_message(context.bot, chat_id, "❌ تعذر تشفير الملف. تحقق من محتوى الملف وحاول مرة أخرى.")
        return

    if isinstance(user_state, dict) and user_state.get("state") == "await_ss7_input":
