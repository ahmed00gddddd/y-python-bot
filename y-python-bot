def _encrypt_code_payload(raw_bytes):
    'Encrypt a source payload with AES-256-GCM and return key, nonce and ciphertext.'
    key = os.urandom(32)
    nonce = os.urandom(12)
    ciphertext = AESGCM(key).encrypt(nonce, raw_bytes, None)
    return key, nonce, ciphertext


def encrypt_python_source(source_bytes):
    'Create a self-contained .py loader carrying an AES-GCM encrypted source payload.'
    key, nonce, ciphertext = _encrypt_code_payload(source_bytes)
    key_b64 = base64.b64encode(key).decode("ascii")
    nonce_b64 = base64.b64encode(nonce).decode("ascii")
    ciphertext_b64 = base64.b64encode(ciphertext).decode("ascii")

    loader = f'''# -*- coding: utf-8 -*-
# Protected Python source generated by the bot.
import base64
from cryptography.hazmat.primitives.ciphers.aead import AESGCM

_KEY = base64.b64decode("{key_b64}")
_NONCE = base64.b64decode("{nonce_b64}")
_DATA = base64.b64decode("{ciphertext_b64}")


def _run_protected_source():
    source = AESGCM(_KEY).decrypt(_NONCE, _DATA, None)
    code = compile(source, __file__, "exec")
    namespace = {{"__name__": "__main__", "__file__": __file__, "__package__": None}}
    exec(code, namespace, namespace)


if __name__ == "__main__":
    _run_protected_source()
'''
    return loader.encode("utf-8")


def encrypt_html_source(source_bytes):
    'Create a self-contained HTML wrapper using the browser Web Crypto AES-GCM API.'
    key, nonce, ciphertext = _encrypt_code_payload(source_bytes)
    key_b64 = base64.b64encode(key).decode("ascii")
    nonce_b64 = base64.b64encode(nonce).decode("ascii")
    ciphertext_b64 = base64.b64encode(ciphertext).decode("ascii")

    html = f'''<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Protected HTML</title>
</head>
<body>
<div id="protected-content"></div>
<script>
(() => {{
  const KEY_B64 = "{key_b64}";
  const IV_B64 = "{nonce_b64}";
  const DATA_B64 = "{ciphertext_b64}";

  const b64ToBytes = (value) => Uint8Array.from(atob(value), c => c.charCodeAt(0));

  async function decryptAndRender() {{
    const key = await crypto.subtle.importKey(
      "raw",
      b64ToBytes(KEY_B64),
      {{ name: "AES-GCM" }},
      false,
      ["decrypt"]
    );

    const plaintext = await crypto.subtle.decrypt(
      {{ name: "AES-GCM", iv: b64ToBytes(IV_B64) }},
      key,
      b64ToBytes(DATA_B64)
    );

    const html = new TextDecoder().decode(plaintext);
    document.open();
    document.write(html);
    document.close();
  }}

  decryptAndRender().catch(() => {{
    document.getElementById("protected-content").textContent =
      "Unable to decrypt protected HTML payload.";
  }});
}})();
</script>
</body>
</html>
'''
    return html.encode("utf-8")


def _send_encrypted_code_file(bot_instance, chat_id, source_bytes, language):
    if language == "python":
        encrypted_bytes = encrypt_python_source(source_bytes)
        output_name = "file.py"
    else:
        encrypted_bytes = encrypt_html_source(source_bytes)
        output_name = "file.html"

    document = io.BytesIO(encrypted_bytes)
    document.name = output_name
    bot_instance.send_document(
        chat_id=chat_id,
        document=document,
        caption=(
            "🔐 تم تشفير الملف بنجاح.\n"
            f"📦 النوع: {'Python' if language == 'python' else 'HTML'}\n"
            f"📄 الملف: `{output_name}`\n"
            "🛡️ الخوارزمية: AES-256-GCM"
        ),
        parse_mode=ParseMode.MARKDOWN,
    )


def _read_uploaded_code_document(bot_instance, update, expected_extension):
    'Download a Telegram document only when its extension matches the requested code type.'
    document = update.message.document if update.message else None
    if not document:
        raise ValueError("لم يتم إرسال ملف.")

    original_name = document.file_name or ""
    if not original_name.lower().endswith(expected_extension):
        raise ValueError(f"أرسل ملفاً بامتداد {expected_extension} فقط.")

    telegram_file = bot_instance.get_file(document.file_id)
    payload = telegram_file.download_as_bytearray()
    return bytes(payload)


def crypto_encode_decode(text, mode="encode"):
    if mode == "encode":
        encoded = base64.b64encode(text.encode("utf-8")).decode("utf-8")
        return f"🔐 *النص بعد التشفير (Base64):*\n`{encoded}`"
    else:
        try:
            decoded = base64.b64decode(text.encode("utf-8")).decode("utf-8")
            return f"🔓 *النص بعد فك التشفير:*\n`{decoded}`"
        except:
            return "❌ خطأ: النص المرسل غير مشفر بشكل صحيح أو غير صالح لفك التشفير."

