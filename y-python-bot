def add_user_points(bot_username, user_id, amount):
    load_made_bot_settings(bot_username)
    if "user_points" not in made_bot_data[bot_username]:
        made_bot_data[bot_username]["user_points"] = {}
    current = made_bot_data[bot_username]["user_points"].get(str(user_id), 0)
    made_bot_data[bot_username]["user_points"][str(user_id)] = current + amount
    save_made_bot_settings(bot_username)

def deduct_user_points(bot_username, user_id, amount):
    load_made_bot_settings(bot_username)
    if "user_points" not in made_bot_data[bot_username]:
        made_bot_data[bot_username]["user_points"] = {}
    current = made_bot_data[bot_username]["user_points"].get(str(user_id), 0)
    made_bot_data[bot_username]["user_points"][str(user_id)] = max(0, current - amount)
    save_made_bot_settings(bot_username)

